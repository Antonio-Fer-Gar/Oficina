{
  "name": "nter-omp-office",
  "version": "0.1.7",
  "description": "Oficina pixel-art que muestra y controla las sesiones de omp",
  "author": "nter",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts && electron .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke:bridge": "bun scripts/smoke-bridge.ts --no-model",
    "bridge": "bun src/install.ts",
    "update:installed": "bun scripts/update.ts",
    "dist": "bun scripts/build.ts && electron-builder --win --x64"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.13.2",
    "@types/bun": "1.4.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "es.nter.oficina-omp",
    "productName": "Oficina nter",
    "directories": { "output": "release" },
    "files": ["dist/**", "assets/**", "package.json"],
    "asarUnpack": ["dist/worker.js", "dist/terminal-launcher.js", "dist/app-update-helper.js"],
    "extraResources": [{ "from": ".superpowers/tools/bun-windows-x64/bun.exe", "to": "bun/bun.exe" }],
    "win": { "target": ["nsis", "dir"], "icon": "assets/nter-logo.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "include": "build/installer.nsh" }
  }
}
